# Server
PORT=4000

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=safepulse_db
DB_USER=safepulse_user
DB_PASSWORD=your_db_password

# JWT
ACCESS_TOKEN_SECRET=your_access_token_secret_min_32_chars
REFRESH_TOKEN_SECRET=your_refresh_token_secret_min_32_chars

# Email (required for verification & password reset to be sent)
# Option A – Gmail: use your Gmail and an App Password (https://support.google.com/accounts/answer/185833)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your.email@gmail.com
SMTP_PASSWORD=your-16-char-app-password
FROM_EMAIL=your.email@gmail.com
# Option B – Mailtrap (dev inbox): sign up at mailtrap.io, use their SMTP credentials

APP_NAME=Safepulse

# Frontend URL – links in emails point here (e.g. reset-password?token=...)
CLIENT_URL=http://localhost:3000
